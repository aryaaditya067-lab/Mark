<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext (plain http://) stays blocked for the whole app.

  The laptop agent on the home LAN has no certificate, but it does not need an
  exception here: LaptopTool talks to it through LanHttp, which refuses any
  address that is not private (192.168.x, 10.x, 172.16-31.x, loopback,
  link-local). The previous entries here looked like address ranges but are
  matched as literal host names, so they only ever allowed one fixed IP.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
