<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+. See
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The laptop agent token is a credential: never copy it off the device. -->
        <exclude domain="sharedpref" path="laptop_agent.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="laptop_agent.xml" />
    </device-transfer>
</data-extraction-rules>
