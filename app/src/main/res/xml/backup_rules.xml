<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (Android 12+ uses
   data_extraction_rules.xml). See
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- The laptop agent token is a credential: never copy it into backups. -->
    <exclude domain="sharedpref" path="laptop_agent.xml" />
</full-backup-content>
